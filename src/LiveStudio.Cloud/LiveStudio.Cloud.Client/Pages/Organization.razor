@page "/organization"
@attribute [Authorize]
@inject HttpClient Http
@inject OrganizationSession Session

<PageTitle>服务器管理 · LiveStudio</PageTitle>

<div class="page-header"><div><h1>服务器管理</h1><p>统一管理当前服务器上的直播间和管理员账户。</p></div></div>
<div class="content-grid">
    <section class="card section-card">
        <div class="section-heading"><h2>直播管理空间</h2></div>
        @if (Session.Organizations.Count > 0)
        {
            <div class="form-field"><label>当前空间</label><select class="form-select" value="@Session.SelectedOrganizationId" @onchange="SelectOrganizationAsync">@foreach (var organization in Session.Organizations) { <option value="@organization.Id">@organization.Name</option> }</select></div>
        }
        else
        {
            <div class="empty-state compact">当前账户没有可管理的直播空间。</div>
        }

        <div class="section-heading mt-5"><h2>直播间</h2></div>
        @if (rooms.Count == 0)
        {
            <div class="empty-state compact">尚未创建直播间。</div>
        }
        else
        {
            <ul class="list">@foreach (var room in rooms) { <li class="list-row"><span class="status-dot @(room.Online ? "online" : null)"></span><div class="list-main"><strong>@room.Name</strong><small>@RoomConnectionText(room)</small></div></li> }</ul>
        }
        <div class="form-field mt-3"><label>新直播间名称</label><input class="form-control" placeholder="例如：1 号直播间" @bind="roomName" /></div>
        <button class="button mt-3" disabled="@(Session.SelectedOrganizationId is null || string.IsNullOrWhiteSpace(roomName))" @onclick="CreateRoomAsync">创建直播间</button>
    </section>

    <section class="card section-card">
        <div class="section-heading"><h2>管理员账户</h2></div>
        <ul class="list">@foreach (var member in members) { <li class="list-row"><span class="avatar-inline">@member.Email[0].ToString().ToUpperInvariant()</span><div class="list-main"><strong>@member.Email</strong><small>@RoleName(member.Role)</small></div></li> }</ul>
        <p class="muted mt-3">此服务器采用单管理员模式。最多 15 台直播电脑都使用这个账户完成浏览器授权；桌面端不会保存密码或 Cookie。</p>
        @if (message is not null) { <p class="muted mt-3">@message</p> }
    </section>
</div>

@if (canViewAudit)
{
    <section class="audit-section table-wrap">
        <div class="section-heading"><h2>最近审计记录</h2><span class="muted">最多显示 200 条</span></div>
        @if (auditEvents.Count == 0)
        {
            <div class="empty-state compact">尚无审计记录。</div>
        }
        else
        {
            <table class="data-table">
                <thead><tr><th>时间</th><th>操作</th><th>执行者</th><th>对象</th></tr></thead>
                <tbody>
                    @foreach (var audit in auditEvents)
                    {
                        <tr>
                            <td>@audit.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><strong>@AuditActionName(audit.Action)</strong></td>
                            <td><code>@ShortIdentifier(audit.ActorId)</code></td>
                            <td>@TargetTypeName(audit.TargetType) · <code>@ShortIdentifier(audit.TargetId)</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private IReadOnlyList<LiveRoomSummary> rooms = [];
    private IReadOnlyList<MembershipSummary> members = [];
    private IReadOnlyList<AuditEventSummary> auditEvents = [];
    private string roomName = string.Empty;
    private string? message;
    private bool canViewAudit;

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        await ReloadResourcesAsync();
    }

    private async Task SelectOrganizationAsync(ChangeEventArgs eventArgs)
    {
        if (Guid.TryParse(eventArgs.Value?.ToString(), out var organizationId))
        {
            Session.Select(organizationId);
            await ReloadResourcesAsync();
        }
    }

    private async Task ReloadResourcesAsync()
    {
        rooms = [];
        members = [];
        auditEvents = [];
        canViewAudit = false;
        if (Session.SelectedOrganizationId is not { } organizationId) return;
        rooms = await Http.GetFromJsonAsync<IReadOnlyList<LiveRoomSummary>>($"/api/v1/organizations/{organizationId}/rooms") ?? [];
        try
        {
            members = await Http.GetFromJsonAsync<IReadOnlyList<MembershipSummary>>($"/api/v1/organizations/{organizationId}/members") ?? [];
            auditEvents = await Http.GetFromJsonAsync<IReadOnlyList<AuditEventSummary>>($"/api/v1/organizations/{organizationId}/audit-events") ?? [];
            canViewAudit = true;
        }
        catch (HttpRequestException)
        {
            message = "当前角色无权查看成员列表。";
        }
    }

    private async Task CreateRoomAsync()
    {
        if (Session.SelectedOrganizationId is not { } organizationId) return;
        var response = await Http.PostAsJsonAsync($"/api/v1/organizations/{organizationId}/rooms", new CreateRoomRequest(roomName));
        message = response.IsSuccessStatusCode ? "直播间已创建。" : "创建失败。";
        if (response.IsSuccessStatusCode) { roomName = string.Empty; await ReloadResourcesAsync(); }
    }

    private static string AuditActionName(string action) => action switch
    {
        "organization.create" => "创建直播管理空间",
        "room.created" => "创建直播间",
        "membership.saved" => "保存成员角色",
        "device-mapping.saved" => "保存设备映射",
        "capture.requested" => "下发联合保存",
        "capture.completed" => "联合保存结束",
        "restore.requested" => "下发存档恢复",
        "restore.completed" => "存档恢复结束",
        "preview-refresh.requested" => "下发画面刷新",
        "preview-refresh.completed" => "画面刷新结束",
        "current-state.refreshed" => "本机刷新当前画面",
        "current-state.remote-refreshed" => "远程刷新当前画面",
        "current-state.restored" => "恢复后上传当前画面",
        "snapshot.created" => "创建画面存档",
        "snapshot.deleted" => "删除画面存档",
        _ => action
    };

    private static string ShortIdentifier(string value) => value.Length <= 24
        ? value
        : $"{value[..10]}…{value[^8..]}";

    private static string RoleName(OrganizationRole role) => role switch
    {
        OrganizationRole.Owner => "所有者",
        OrganizationRole.Admin => "管理员",
        OrganizationRole.Operator => "操作员",
        OrganizationRole.Viewer => "只读查看",
        _ => role.ToString()
    };

    private static string RoomConnectionText(LiveRoomSummary room) => room.DeviceId is null
        ? "尚未绑定直播电脑"
        : room.Online
            ? "直播电脑在线"
            : "直播电脑离线";

    private static string TargetTypeName(string targetType) => targetType switch
    {
        "organization" => "直播管理空间",
        "LiveRoom" => "直播间",
        "Membership" => "成员",
        "ManagedDevice" => "直播电脑",
        "Snapshot" => "画面存档",
        "RemoteJob" => "远程任务",
        _ => targetType
    };
}
