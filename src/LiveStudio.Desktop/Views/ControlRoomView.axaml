<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiveStudio.Desktop.ViewModels"
             xmlns:contracts="using:LiveStudio.Contracts"
             x:Class="LiveStudio.Desktop.Views.ControlRoomView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="72,*">
        <Grid Margin="28,0" ColumnDefinitions="*,Auto" Classes="toolbar">
            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Classes="page-title" Text="控制室" />
                <TextBlock Classes="page-subtitle" Text="{Binding ConnectionSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock Margin="0,0,6,0" Classes="toolbar-context" VerticalAlignment="Center" Text="{Binding PlatformMode}" />
                <Button Classes="standard" IsVisible="{Binding IsDisconnected}"
                        Command="{Binding OpenConnectionSettingsCommand}">连接电脑…</Button>
                <Button Classes="standard" AutomationProperties.Name="选择并恢复画面存档" IsVisible="{Binding IsAgentConnected}"
                        Command="{Binding RestoreSnapshotCommand}">恢复</Button>
                <Button Classes="standard accent" AutomationProperties.Name="联合保存 OBS 和直播伴侣当前画面参数" IsVisible="{Binding IsAgentConnected}"
                        Command="{Binding CaptureSnapshotCommand}">保存当前画面</Button>
            </StackPanel>
            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="#16FFFFFF" />
        </Grid>

        <Grid Grid.Row="1" IsVisible="{Binding IsDisconnected}">
            <StackPanel Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Path Width="34" Height="34" Margin="0,0,0,5" HorizontalAlignment="Center"
                      Data="M4,8 A3,3 0 0 1 7,5 L17,5 A3,3 0 0 1 20,8 L20,16 A3,3 0 0 1 17,19 L7,19 A3,3 0 0 1 4,16 Z M9,12 L15,12 M12,9 L12,15"
                      Stretch="Uniform" Stroke="#6CA6FF" StrokeThickness="1.35" />
                <TextBlock Classes="empty-heading" Text="{Binding ControlStatusTitle}" TextAlignment="Center" />
                <TextBlock Classes="empty-body" Text="{Binding ControlStatusDescription}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <Button Classes="standard" HorizontalAlignment="Center"
                        Command="{Binding OpenConnectionSettingsCommand}">配置连接</Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" IsVisible="{Binding IsAgentConnected}" ColumnDefinitions="0.68*,0.32*">
            <Grid Classes="preview-pane">
                <StackPanel Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Path Width="34" Height="34" Margin="0,0,0,5" HorizontalAlignment="Center"
                          Data="M4,8 A3,3 0 0 1 7,5 L17,5 A3,3 0 0 1 20,8 L20,16 A3,3 0 0 1 17,19 L7,19 A3,3 0 0 1 4,16 Z M9,12 L15,12 M12,9 L12,15"
                          Stretch="Uniform" Stroke="#6CA6FF" StrokeThickness="1.35" />
                    <TextBlock Classes="empty-heading" Text="{Binding ControlStatusTitle}" TextAlignment="Center" />
                    <TextBlock Classes="empty-body" Text="{Binding ControlStatusDescription}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Orientation="Horizontal" Spacing="8">
                    <Border Width="7" Height="7" CornerRadius="4" Background="#30D158" VerticalAlignment="Center" />
                    <TextBlock Classes="quiet-label" Text="{Binding ConfigurationStatus}" />
                </StackPanel>
                <Border VerticalAlignment="Bottom" Classes="status-bar">
                    <Grid Height="54" ColumnDefinitions="*,*,*">
                        <StackPanel Margin="18,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="meta-label" Text="配置状态" />
                            <TextBlock Classes="meta-value" Text="{Binding ConfigurationStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="meta-label" Text="执行端" />
                            <TextBlock Classes="meta-value" Text="{Binding AgentStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="18,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="meta-label" Text="存档" />
                            <TextBlock Classes="meta-value" Text="{Binding SnapshotCountText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Classes="inspector">
                <StackPanel>
                    <TextBlock Margin="18,18,18,14" Classes="inspector-title" Text="检查器" />
                    <Border Height="1" Background="#14FFFFFF" />
                    <StackPanel Margin="18,16" Spacing="13">
                        <TextBlock Classes="group-label" Text="连接" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="row-label" Text="直播电脑" />
                            <TextBlock Grid.Column="1" Classes="row-value" Text="{Binding DeviceName}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="row-label" Text="本机执行端" />
                            <TextBlock Grid.Column="1" Classes="row-value" Text="{Binding AgentStatus}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="row-label" Text="云端同步" />
                            <TextBlock Grid.Column="1" Classes="row-value" Text="{Binding CloudStatus}" />
                        </Grid>
                    </StackPanel>
                    <Border Height="1" Margin="18,0" Background="#14FFFFFF" />
                    <StackPanel Margin="18,16" Spacing="13">
                        <TextBlock Classes="group-label" Text="当前配置" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="row-label" Text="OBS" />
                            <TextBlock Grid.Column="1" Classes="row-value" Text="{Binding ObsStatus}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="row-label" Text="直播伴侣" />
                            <TextBlock Grid.Column="1" Classes="row-value" Text="{Binding LiveCompanionStatus}" />
                        </Grid>
                    </StackPanel>
                    <Border Height="1" Margin="18,0" Background="#14FFFFFF" />
                    <StackPanel Margin="18,16" Spacing="8">
                        <TextBlock Classes="group-label" Text="恢复安全" />
                        <TextBlock Classes="inspector-note"
                                   Text="恢复前会检查直播状态、设备能力并创建事务快照。任何字段回读不一致都会回滚。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" IsVisible="{Binding IsCloudControlVisible}" ColumnDefinitions="250,*">
            <Border BorderBrush="#16FFFFFF" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Margin="20,16,16,12" Spacing="6">
                        <TextBlock Classes="group-label" Text="组织" />
                        <ComboBox Classes="mapping-picker" MinHeight="32"
                                  ItemsSource="{Binding Organizations}"
                                  SelectedItem="{Binding SelectedOrganization}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="contracts:OrganizationSummary">
                                    <TextBlock Classes="section-heading" Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <ListBox Grid.Row="1" Margin="10,0,10,14" Classes="mapping-list"
                             ItemsSource="{Binding CloudRooms}" SelectedItem="{Binding SelectedCloudRoom}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CloudRoomItemViewModel">
                                <Grid MinHeight="56" Margin="10,0" ColumnDefinitions="8,*,Auto" ColumnSpacing="10">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="#73767D" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Classes="snapshot-name" Text="{Binding Name}" />
                                        <TextBlock Classes="snapshot-meta" Text="{Binding LastSnapshot}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="mapping-status" VerticalAlignment="Center"
                                               Text="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <Grid Margin="28,24,28,22" RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="page-title" FontSize="19" Text="{Binding SelectedCloudRoom.Name}" />
                            <TextBlock Classes="page-subtitle" Text="{Binding ControlStatusDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="toolbar-action" Command="{Binding RefreshCloudPreviewCommand}">刷新画面</Button>
                            <Button Classes="standard" Command="{Binding RestoreSnapshotCommand}">应用存档</Button>
                            <Button Classes="standard accent" Command="{Binding CaptureCloudSnapshotCommand}">联合保存</Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0" ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Grid RowDefinitions="*,Auto">
                            <Border Background="#101012" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding CurrentObsPreview}" Stretch="Uniform" />
                                    <TextBlock IsVisible="{Binding !HasObsPreview}" Classes="inline-empty"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="尚无 OBS 当前画面" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="2,9,2,0" ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section-heading" Text="OBS" />
                                <TextBlock Grid.Column="1" Classes="snapshot-meta" Text="{Binding ObsStatus}" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="1" RowDefinitions="*,Auto">
                            <Border Background="#101012" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding CurrentLiveCompanionPreview}" Stretch="Uniform" />
                                    <TextBlock IsVisible="{Binding !HasLiveCompanionPreview}" Classes="inline-empty"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="尚无直播伴侣当前画面" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="2,9,2,0" ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section-heading" Text="直播伴侣" />
                                <TextBlock Grid.Column="1" Classes="snapshot-meta" Text="{Binding LiveCompanionStatus}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Classes="status-bar">
                    <Grid Height="54" ColumnDefinitions="*,*,*">
                        <StackPanel Margin="18,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="meta-label" Text="设备状态" />
                            <TextBlock Classes="meta-value" Text="{Binding AgentStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="meta-label" Text="配置状态" />
                            <TextBlock Classes="meta-value" Text="{Binding ConfigurationStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="18,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="meta-label" Text="云端存档" />
                            <TextBlock Classes="meta-value" Text="{Binding SnapshotCountText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
