<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiveStudio.Desktop.ViewModels"
             xmlns:views="using:LiveStudio.Desktop.Views"
             x:Class="LiveStudio.Desktop.Views.SettingsView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="52,*">
        <Grid Margin="28,0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
            <Button Classes="settings-back" VerticalAlignment="Center"
                    Command="{Binding SelectSectionCommand}" CommandParameter="1">←  返回存档管理</Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <ToggleButton x:Name="BasicSettingsTab" Classes="settings-tab" IsChecked="True"
                              Click="BasicSettingsTabClicked">基础设置</ToggleButton>
                <ToggleButton x:Name="ActivitySettingsTab" Classes="settings-tab"
                              Click="ActivitySettingsTabClicked">操作记录</ToggleButton>
            </StackPanel>
            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource ArchiveSeparatorBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Stretch"
                      IsVisible="{Binding IsChecked, ElementName=BasicSettingsTab}">
            <StackPanel MaxWidth="960" Margin="28,26" HorizontalAlignment="Stretch" Spacing="18">
                <Border Classes="settings-card">
                    <StackPanel>
                        <Grid MinHeight="72" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Classes="settings-title" Text="外观" />
                                <TextBlock Classes="settings-copy" Text="跟随 Windows，或固定使用浅色、深色界面" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                      Classes="mapping-picker" ItemsSource="{Binding ThemeModes}"
                                      SelectedItem="{Binding SelectedThemeMode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeModeOptionViewModel">
                                        <TextBlock Classes="settings-title" Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource ArchiveSeparatorBrush}" />

                        <Grid MinHeight="82" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <StackPanel Margin="0,10" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Classes="settings-title" Text="连接 OBS 和直播伴侣" />
                                <TextBlock Classes="settings-copy" Text="自动检测当前电脑，不需要填写地址、密码或账号" />
                                <TextBlock MaxWidth="560" HorizontalAlignment="Left" Classes="settings-copy"
                                           Text="{Binding SettingsMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Classes="settings-value" VerticalAlignment="Center" Text="{Binding AgentStatus}" />
                                <Button Classes="standard accent" Command="{Binding AutoConfigureObsCommand}">一键连接</Button>
                                <Button Classes="standard" Command="{Binding RefreshStateCommand}">重新检测</Button>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource ArchiveSeparatorBrush}" />

                        <Grid MinHeight="92" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <StackPanel Margin="0,10" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Classes="settings-title" Text="本机检查与修复" />
                                <TextBlock MaxWidth="560" HorizontalAlignment="Left" Classes="settings-copy"
                                           Text="检查并修复执行端、自启动以及 OBS、直播伴侣连接；不会恢复画面，也不会上传数据。"
                                           TextWrapping="Wrap" />
                                <TextBlock MaxWidth="560" HorizontalAlignment="Left" Classes="settings-copy"
                                           Text="{Binding LocalCheckStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="standard accent" VerticalAlignment="Center"
                                    Command="{Binding RunLocalCheckAndRepairCommand}">检查并修复</Button>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource ArchiveSeparatorBrush}" />

                        <Grid MinHeight="72" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Classes="settings-title" Text="开机后自动运行" />
                                <TextBlock Classes="settings-copy" Text="Windows 登录后自动启动本机执行端，确保随时可以保存和检查" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Classes="settings-value" VerticalAlignment="Center" Text="已开启" IsVisible="{Binding IsAgentAutoStartEnabled}" />
                                <TextBlock Classes="settings-value" VerticalAlignment="Center" Text="已关闭" IsVisible="{Binding !IsAgentAutoStartEnabled}" />
                                <Button Classes="standard" IsVisible="{Binding IsAgentAutoStartEnabled}"
                                         Command="{Binding DisableAgentAutoStartCommand}">关闭</Button>
                                <Button Classes="standard" IsVisible="{Binding !IsAgentAutoStartEnabled}"
                                        Command="{Binding EnableAgentAutoStartCommand}">开启</Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Classes="settings-section" Text="软件更新" />
                <Border Classes="settings-card">
                    <Grid MinHeight="96" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Margin="0,10" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Classes="settings-title" Text="检查并安装新版本" />
                            <TextBlock Classes="settings-copy" Text="直接读取 LiveStudio 公开发布版本，不需要 GitHub 账号或 Token" />
                            <TextBlock MaxWidth="540" HorizontalAlignment="Left" Classes="settings-copy"
                                       Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <TextBlock Classes="settings-value" Text="{Binding CurrentVersionText}" />
                                <TextBlock Classes="settings-copy" Text="→" />
                                <TextBlock Classes="settings-value" Text="{Binding LatestVersionText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Classes="standard" Command="{Binding CheckForUpdatesCommand}">检查更新</Button>
                                <Button Classes="standard accent" Command="{Binding InstallUpdateCommand}">下载并安装</Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="14,12" CornerRadius="10" Background="{DynamicResource ArchiveRaisedBrush}">
                    <TextBlock Classes="settings-copy" TextWrapping="Wrap"
                               Text="当前为单机直播间版本：画面存档保存在这台电脑，也可以在“画面存档”中导出 .lscfg 文件，交给另一台直播电脑导入并应用。" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <views:ActivityView Grid.Row="1" IsVisible="{Binding IsChecked, ElementName=ActivitySettingsTab}" />
    </Grid>
</UserControl>
