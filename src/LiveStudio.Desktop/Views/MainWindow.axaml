<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiveStudio.Desktop.ViewModels"
        xmlns:views="using:LiveStudio.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="820"
        x:Class="LiveStudio.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1240"
        Height="780"
        MinWidth="760"
        MinHeight="560"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        Background="{DynamicResource AppWindowBrush}"
        Title="LiveStudio">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="36,*">
        <Border Grid.Row="0" Classes="app-titlebar"
                WindowDecorationProperties.ElementRole="TitleBar">
            <Grid Margin="104,0,146,0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="4">
                <Button Classes="title-nav" Classes.active="{Binding IsControlVisible}"
                        Command="{Binding SelectSectionCommand}" CommandParameter="0">备份与恢复</Button>
                <Button Grid.Column="1" Classes="title-nav" Classes.active="{Binding IsSnapshotsVisible}"
                        Command="{Binding SelectSectionCommand}" CommandParameter="1">存档管理</Button>
                <Button Grid.Column="2" Classes="title-nav" Classes.active="{Binding IsActivityVisible}"
                        Command="{Binding SelectSectionCommand}" CommandParameter="2">操作记录</Button>
                <StackPanel Grid.Column="4" Margin="8,0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                    <Border Width="6" Height="6" Classes="device-status-dot" />
                    <TextBlock Classes="title-device" Text="{Binding DeviceName}" />
                </StackPanel>
                <Button Grid.Column="5" Classes="title-nav" Classes.active="{Binding IsSettingsVisible}"
                        Command="{Binding SelectSectionCommand}" CommandParameter="3">设置</Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource AppWindowBrush}">
            <views:ControlRoomView IsVisible="{Binding IsControlVisible}" />
            <views:SnapshotsView IsVisible="{Binding IsSnapshotsVisible}" />
            <views:ActivityView IsVisible="{Binding IsActivityVisible}" />
            <views:SettingsView IsVisible="{Binding IsSettingsVisible}" />
        </Grid>
    </Grid>
</Window>
