<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiveStudio.Desktop.ViewModels"
        xmlns:views="using:LiveStudio.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="820"
        x:Class="LiveStudio.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1240"
        Height="780"
        MinWidth="760"
        MinHeight="560"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="False"
        Background="{DynamicResource AppWindowBrush}"
        Title="LiveStudio">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Background="{DynamicResource AppWindowBrush}">
        <views:SnapshotsView x:Name="SnapshotsPage" IsVisible="{Binding IsSnapshotsVisible}" />
        <views:SettingsView IsVisible="{Binding IsSettingsVisible}" />
    </Grid>
</Window>
