<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#F5F5F7" />
    </Style>

    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="#222326" />
        <Setter Property="BorderBrush" Value="#12FFFFFF" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.brand-mark">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="#0A84FF" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.brand-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FAFAFC" />
    </Style>
    <Style Selector="TextBlock.brand-caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#8F9299" />
    </Style>
    <Style Selector="TextBlock.nav-section-label">
        <Setter Property="Margin" Value="8,0,0,5" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#777A80" />
    </Style>
    <Style Selector="Button.nav">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="#C9C9CE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.nav:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="#10FFFFFF" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="#345A8BC4" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Path.nav-icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="#A7A9AF" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.nav.active Path.nav-icon"><Setter Property="Stroke" Value="#74B4FF" /></Style>
    <Style Selector="Border.sidebar-separator"><Setter Property="Height" Value="1" /><Setter Property="Margin" Value="8,0,8,3" /><Setter Property="Background" Value="#12FFFFFF" /></Style>
    <Style Selector="Border.device-card"><Setter Property="Padding" Value="9,7" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Border.device-status-dot"><Setter Property="CornerRadius" Value="3" /><Setter Property="Background" Value="#777A80" /></Style>
    <Style Selector="TextBlock.device-name"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="#D7D7DC" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    <Style Selector="TextBlock.device-mode"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#777A80" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>

    <Style Selector="Grid.toolbar"><Setter Property="Background" Value="#1C1C1E" /></Style>
    <Style Selector="TextBlock.page-title"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="-0.35" /><Setter Property="Foreground" Value="#F5F5F7" /></Style>
    <Style Selector="TextBlock.page-subtitle"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.toolbar-context"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#8E8E93" /></Style>

    <Style Selector="Button.standard">
        <Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="13,5" />
        <Setter Property="Background" Value="#12FFFFFF" /><Setter Property="BorderBrush" Value="#24FFFFFF" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" />
        <Setter Property="Foreground" Value="#F2F2F5" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.standard:pointerover"><Setter Property="Background" Value="#1DFFFFFF" /></Style>
    <Style Selector="Button.standard.accent"><Setter Property="Background" Value="#0A84FF" /><Setter Property="BorderBrush" Value="#0A84FF" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.standard:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="Button.toolbar-action">
        <Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="9,5" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Foreground" Value="#B9B9BF" />
        <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.toolbar-action:pointerover"><Setter Property="Background" Value="#11FFFFFF" /><Setter Property="Foreground" Value="#FFFFFF" /></Style>
    <Style Selector="Button.toolbar-action:disabled"><Setter Property="Opacity" Value="0.42" /></Style>
    <Style Selector="Button.link"><Setter Property="Padding" Value="5" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#64A7FF" /><Setter Property="FontSize" Value="12" /></Style>

    <Style Selector="Grid.preview-pane"><Setter Property="Background" Value="#171719" /></Style>
    <Style Selector="TextBlock.empty-heading"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#EFEFF2" /></Style>
    <Style Selector="TextBlock.empty-body"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.quiet-label"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#98989E" /></Style>
    <Style Selector="Border.status-bar"><Setter Property="Background" Value="#242426" /><Setter Property="BorderBrush" Value="#20FFFFFF" /><Setter Property="BorderThickness" Value="0,1,0,0" /></Style>
    <Style Selector="TextBlock.meta-label"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.meta-value"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#E5E5EA" /></Style>

    <Style Selector="Border.inspector"><Setter Property="Background" Value="#242426" /><Setter Property="BorderBrush" Value="#20FFFFFF" /><Setter Property="BorderThickness" Value="1,0,0,0" /></Style>
    <Style Selector="TextBlock.inspector-title"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#E5E5EA" /></Style>
    <Style Selector="TextBlock.group-label"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.row-label"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#D1D1D6" /></Style>
    <Style Selector="TextBlock.row-value"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#98989E" /></Style>
    <Style Selector="TextBlock.inspector-note"><Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="17" /><Setter Property="Foreground" Value="#98989E" /></Style>
    <Style Selector="TextBlock.verification"><Setter Property="FontSize" Value="10" /><Setter Property="LineHeight" Value="15" /><Setter Property="Foreground" Value="#30D158" /></Style>
    <Style Selector="TextBlock.detail-title"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="-0.25" /><Setter Property="Foreground" Value="#F5F5F7" /></Style>
    <Style Selector="TextBlock.detail-meta"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.application-title"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#F2F2F5" /></Style>
    <Style Selector="TextBlock.source-title"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#EDEDF0" /></Style>
    <Style Selector="TextBlock.section-kicker"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.parameter-label"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.parameter-value"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#D9D9DE" /></Style>
    <Style Selector="TextBlock.parameter-value-strong"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="#E9E9ED" /></Style>
    <Style Selector="TextBlock.technical-value"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#73737A" /></Style>
    <Style Selector="TextBlock.technical-key"><Setter Property="FontSize" Value="9" /><Setter Property="Foreground" Value="#64646B" /></Style>
    <Style Selector="TextBlock.technical-heading"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#9A9AA1" /></Style>
    <Style Selector="TextBlock.filter-title"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#E9E9ED" /></Style>
    <Style Selector="TextBlock.filter-order"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#A0A0A7" /></Style>
    <Style Selector="Expander.technical-expander"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="TextBlock.section-heading"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#E5E5EA" /></Style>
    <Style Selector="TextBlock.inline-empty"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.column-heading"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#8E8E93" /></Style>

    <Style Selector="ListBox.snapshot-list, ListBox.mapping-list"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBox.snapshot-list ListBoxItem, ListBox.mapping-list ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="ListBox.snapshot-list ListBoxItem:selected, ListBox.mapping-list ListBoxItem:selected"><Setter Property="Background" Value="#345E8FD8" /></Style>
    <Style Selector="ListBox.compact-menu, ListBox.app-switch"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBox.compact-menu ListBoxItem, ListBox.app-switch ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style Selector="ListBox.compact-menu ListBoxItem:selected, ListBox.app-switch ListBoxItem:selected"><Setter Property="Background" Value="#345E8FD8" /></Style>
    <Style Selector="TextBlock.snapshot-name"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="#ECECF0" /></Style>
    <Style Selector="TextBlock.snapshot-meta"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.snapshot-time"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="#B6B6BC" /></Style>
    <Style Selector="TextBlock.timeline-date"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#70AEFF" /></Style>
    <Style Selector="ComboBox.room-picker"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="2,3" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.room-picker-name"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#F0F0F3" /></Style>
    <Style Selector="TextBlock.room-picker-count"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.transfer-message"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#B7B7BD" /></Style>
    <Style Selector="Border.coverage-inspector"><Setter Property="Background" Value="#1F1F21" /><Setter Property="BorderBrush" Value="#20FFFFFF" /><Setter Property="BorderThickness" Value="1,0,0,0" /></Style>
    <Style Selector="Border.coverage-notice"><Setter Property="Padding" Value="10,8" /><Setter Property="Background" Value="#0FFF9F0A" /><Setter Property="BorderBrush" Value="#7AFF9F0A" /><Setter Property="BorderThickness" Value="2,0,0,0" /></Style>
    <Style Selector="TextBlock.coverage-notice-text"><Setter Property="FontSize" Value="10" /><Setter Property="LineHeight" Value="15" /><Setter Property="Foreground" Value="#B8B8BE" /></Style>
    <Style Selector="TextBlock.coverage-status"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#E4E4E8" /></Style>
    <Style Selector="TextBlock.coverage-summary"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#85858C" /></Style>
    <Style Selector="TextBlock.coverage-application"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#F0F0F3" /></Style>
    <Style Selector="TextBlock.coverage-count"><Setter Property="FontSize" Value="9" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.coverage-meta-label"><Setter Property="FontSize" Value="9" /><Setter Property="Foreground" Value="#67676E" /></Style>
    <Style Selector="TextBlock.coverage-meta-value"><Setter Property="FontSize" Value="9" /><Setter Property="Foreground" Value="#929299" /></Style>
    <Style Selector="TextBlock.coverage-field-name"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="#DADADF" /></Style>
    <Style Selector="TextBlock.coverage-field-state"><Setter Property="FontSize" Value="9" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.coverage-field-value"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#F0F0F3" /></Style>
    <Style Selector="TextBlock.coverage-field-path"><Setter Property="FontSize" Value="9" /><Setter Property="Foreground" Value="#6E6E75" /></Style>
    <Style Selector="TextBlock.coverage-field-meta"><Setter Property="FontSize" Value="9" /><Setter Property="Foreground" Value="#85858C" /></Style>
    <Style Selector="TextBlock.mapping-application"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.mapping-status"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#64A7FF" /></Style>
    <Style Selector="ComboBox.mapping-picker"><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="10,5" /><Setter Property="Background" Value="#14FFFFFF" /><Setter Property="BorderBrush" Value="#28FFFFFF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" /></Style>

    <Style Selector="TextBlock.settings-section"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.settings-title"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#F0F0F3" /></Style>
    <Style Selector="TextBlock.settings-copy"><Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="16" /><Setter Property="Foreground" Value="#8E8E93" /></Style>
    <Style Selector="TextBlock.settings-value"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#B8B8BE" /></Style>
    <Style Selector="Border.settings-card"><Setter Property="Padding" Value="18,2" /><Setter Property="Background" Value="#0CFFFFFF" /><Setter Property="BorderBrush" Value="#1CFFFFFF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Expander.settings-expander"><Setter Property="Padding" Value="16,13" /><Setter Property="Background" Value="#08FFFFFF" /><Setter Property="BorderBrush" Value="#18FFFFFF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="TextBlock.authorization-code-inline"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="1.2" /><Setter Property="Foreground" Value="#75B4FF" /></Style>
    <Style Selector="TextBox.settings-input"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="9,5" /><Setter Property="Background" Value="#14FFFFFF" /><Setter Property="BorderBrush" Value="#28FFFFFF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Foreground" Value="#F1F1F4" /><Setter Property="FontSize" Value="12" /></Style>

    <!-- 画面存档：系统主题自适应的高密度语义样式。 -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource AppSidebarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" />
    </Style>
    <Style Selector="TextBlock.brand-title, TextBlock.device-name"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="TextBlock.brand-caption, TextBlock.device-mode, TextBlock.nav-section-label"><Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" /></Style>
    <Style Selector="Button.nav"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /></Style>
    <Style Selector="Button.nav:pointerover"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="Background" Value="{DynamicResource ArchiveHoverBrush}" /></Style>
    <Style Selector="Button.nav.active"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="Background" Value="{DynamicResource ArchiveSelectionBrush}" /></Style>
    <Style Selector="Path.nav-icon"><Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}" /></Style>
    <Style Selector="Border.sidebar-separator"><Setter Property="Background" Value="{DynamicResource ArchiveSeparatorBrush}" /></Style>
    <Style Selector="TextBlock.archive-title"><Setter Property="FontSize" Value="21" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="TextBlock.archive-section"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="TextBlock.archive-label"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="TextBlock.archive-value"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /></Style>
    <Style Selector="TextBlock.archive-meta"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" /></Style>
    <Style Selector="Border.archive-timeline"><Setter Property="Background" Value="{DynamicResource ArchiveSidebarBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
    <Style Selector="Border.archive-context"><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="BorderThickness" Value="0,0,1,0" /></Style>
    <Style Selector="Border.archive-header"><Setter Property="Background" Value="{DynamicResource ArchiveContentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
    <Style Selector="Border.archive-warning"><Setter Property="Padding" Value="10,7" /><Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="Border.archive-filter"><Setter Property="Padding" Value="10,8" /><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Border.archive-field"><Setter Property="Margin" Value="0,0,8,4" /><Setter Property="Padding" Value="8,3" /><Setter Property="MinHeight" Value="26" /><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style Selector="Button.archive-primary"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="14,5" /><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.archive-primary:pointerover"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" /></Style>
    <Style Selector="Border.camera-image-drop"><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.camera-image-drop:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.camera-image-picker"><Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Button.camera-image-picker:pointerover"><Setter Property="Background" Value="{DynamicResource ArchiveSelectedBrush}" /></Style>
    <Style Selector="Button.camera-image-remove"><Setter Property="Background" Value="{DynamicResource ArchiveImageCaptionBrush}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="15" /><Setter Property="FontSize" Value="17" /></Style>
    <Style Selector="TextBlock.camera-image-caption"><Setter Property="Foreground" Value="White" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.camera-image-caption-meta"><Setter Property="Foreground" Value="#D8FFFFFF" /><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Button.archive-secondary"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="12,5" /><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="Button.archive-danger"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="14,5" /><Setter Property="Background" Value="{DynamicResource DangerBrush}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="ToggleButton.archive-secondary"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="12,4" /><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="ToggleButton.archive-secondary:checked"><Setter Property="Background" Value="{DynamicResource ArchiveSelectionBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.archive-icon"><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontSize" Value="17" /></Style>
    <Style Selector="Button.archive-icon:pointerover"><Setter Property="Background" Value="{DynamicResource ArchiveHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="ListBox.archive-list, ListBox.archive-context-list, ListBox.archive-segment"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBox.archive-list ListBoxItem, ListBox.archive-context-list ListBoxItem, ListBox.archive-segment ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,2" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="ListBox.archive-list ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource ArchiveSelectionBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /></Style>
    <Style Selector="ListBox.archive-context-list ListBoxItem:selected, ListBox.archive-segment ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource ArchiveSelectionBrush}" /></Style>
    <Style Selector="ListBox.archive-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.archive-context-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.archive-segment ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ArchiveSelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="ListBox.archive-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.archive-context-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.archive-segment ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ArchiveSelectionBrush}" /></Style>
    <Style Selector="ListBox.archive-list ListBoxItem:pointerover, ListBox.archive-context-list ListBoxItem:pointerover, ListBox.archive-segment ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource ArchiveHoverBrush}" /></Style>
    <Style Selector="ListBox.archive-segment"><Setter Property="Padding" Value="2" /><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="CornerRadius" Value="9" /></Style>
    <Style Selector="Button.archive-segment-camera"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="12,4" /><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Button.archive-segment-camera:pointerover"><Setter Property="Background" Value="{DynamicResource ArchiveHoverBrush}" /></Style>
    <Style Selector="Button.archive-segment-camera.active"><Setter Property="Background" Value="{DynamicResource ArchiveSelectionBrush}" /></Style>
    <Style Selector="TextBox.archive-search"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="9,4" /><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Border.archive-technical-sheet"><Setter Property="Width" Value="400" /><Setter Property="Background" Value="{DynamicResource TechnicalPanelBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="BorderThickness" Value="1,0,0,0" /><Setter Property="BoxShadow" Value="-8 0 24 0 #30000000" /></Style>
    <Style Selector="Border.archive-restore-sheet"><Setter Property="Width" Value="560" /><Setter Property="Background" Value="{DynamicResource TechnicalPanelBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="BorderThickness" Value="1,0,0,0" /><Setter Property="BoxShadow" Value="-8 0 24 0 #30000000" /></Style>

    <!-- 全应用语义颜色：覆盖旧页面残留的固定深色。 -->
    <Style Selector="Grid.toolbar"><Setter Property="Background" Value="{DynamicResource AppWindowBrush}" /></Style>
    <Style Selector="TextBlock.page-title, TextBlock.empty-heading, TextBlock.detail-title, TextBlock.application-title, TextBlock.source-title, TextBlock.parameter-value-strong, TextBlock.filter-title, TextBlock.section-heading, TextBlock.snapshot-name, TextBlock.room-picker-name, TextBlock.coverage-status, TextBlock.coverage-application, TextBlock.coverage-field-name, TextBlock.coverage-field-value, TextBlock.settings-title"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="TextBlock.page-subtitle, TextBlock.toolbar-context, TextBlock.quiet-label, TextBlock.meta-label, TextBlock.detail-meta, TextBlock.section-kicker, TextBlock.parameter-label, TextBlock.technical-value, TextBlock.technical-key, TextBlock.technical-heading, TextBlock.filter-order, TextBlock.inline-empty, TextBlock.column-heading, TextBlock.snapshot-meta, TextBlock.room-picker-count, TextBlock.coverage-summary, TextBlock.coverage-count, TextBlock.coverage-meta-label, TextBlock.coverage-field-state, TextBlock.coverage-field-path, TextBlock.coverage-field-meta, TextBlock.mapping-application, TextBlock.settings-section, TextBlock.settings-copy"><Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" /></Style>
    <Style Selector="TextBlock.empty-body, TextBlock.meta-value, TextBlock.inspector-title, TextBlock.group-label, TextBlock.row-label, TextBlock.row-value, TextBlock.inspector-note, TextBlock.parameter-value, TextBlock.snapshot-time, TextBlock.transfer-message, TextBlock.coverage-notice-text, TextBlock.coverage-meta-value, TextBlock.settings-value"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /></Style>
    <Style Selector="TextBlock.verification"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></Style>
    <Style Selector="TextBlock.timeline-date, TextBlock.mapping-status, TextBlock.authorization-code-inline"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Button.standard"><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="Button.standard:pointerover"><Setter Property="Background" Value="{DynamicResource ArchiveHoverBrush}" /></Style>
    <Style Selector="Button.standard.accent"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.toolbar-action"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /></Style>
    <Style Selector="Button.toolbar-action:pointerover"><Setter Property="Background" Value="{DynamicResource ArchiveHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="Button.link"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Grid.preview-pane"><Setter Property="Background" Value="{DynamicResource ArchiveContentBrush}" /></Style>
    <Style Selector="Border.status-bar"><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /></Style>
    <Style Selector="Border.inspector, Border.coverage-inspector"><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /></Style>
    <Style Selector="ListBox.snapshot-list ListBoxItem:selected, ListBox.mapping-list ListBoxItem:selected, ListBox.compact-menu ListBoxItem:selected, ListBox.app-switch ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource ArchiveSelectionBrush}" /></Style>
    <Style Selector="Border.coverage-notice"><Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource WarningAccentBrush}" /></Style>
    <Style Selector="ComboBox.mapping-picker"><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style Selector="Border.settings-card"><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /></Style>
    <Style Selector="Expander.settings-expander"><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /></Style>
    <Style Selector="TextBox.settings-input"><Setter Property="Background" Value="{DynamicResource ArchiveRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ArchiveSeparatorBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Style>
</Styles>
