<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>LiveStudio</ApplicationTitle>
    <Product>LiveStudio</Product>
    <ApplicationIcon>Assets\LiveStudio.ico</ApplicationIcon>
    <LiveStudioUpdatePublisher Condition="'$(LiveStudioUpdatePublisher)' == ''"></LiveStudioUpdatePublisher>
    <LiveStudioUpdateCertificateThumbprint Condition="'$(LiveStudioUpdateCertificateThumbprint)' == ''"></LiveStudioUpdateCertificateThumbprint>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Cloud\LiveStudio-Cloud-Root-CA.crt" />
    <EmbeddedResource Include="Assets\Cloud\LiveStudio-Cloud-Root-CA.crt"
                      LogicalName="LiveStudio.Desktop.Assets.Cloud.LiveStudio-Cloud-Root-CA.crt" />
    <AssemblyMetadata Include="LiveStudioUpdatePublisher" Value="$(LiveStudioUpdatePublisher)" />
    <AssemblyMetadata Include="LiveStudioUpdateCertificateThumbprint" Value="$(LiveStudioUpdateCertificateThumbprint)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveStudio.Contracts\LiveStudio.Contracts.csproj" />
    <ProjectReference Include="..\LiveStudio.Packaging\LiveStudio.Packaging.csproj" />
  </ItemGroup>
</Project>
