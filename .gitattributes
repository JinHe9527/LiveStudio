# Keep source and configuration text stable across Windows and Linux runners.
* text=auto eol=lf

# The OBS color-card manifest has a canonical LF representation.
src/LiveStudio.Agent/BuiltInAssets/ColorCards/v1/manifest.json text eol=lf

# LUTs and reference images are integrity-checked byte-for-byte.
src/LiveStudio.Agent/BuiltInAssets/ColorCards/v1/cube/** -text -eol
src/LiveStudio.Agent/BuiltInAssets/ColorCards/v1/png/** -text -eol
