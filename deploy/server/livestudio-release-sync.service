[Unit]
Description=Mirror the latest LiveStudio Windows release for mainland China
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/livestudio-release-sync
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/www/livestudio-downloads
